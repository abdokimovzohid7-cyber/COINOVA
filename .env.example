# Copy to .env at project root
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coinova
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
JWT_SECRET=replace_with_a_unique_64_character_random_secret
PUBLIC_ORIGIN=http://localhost:5173
PORT=4000
# Development only: must remain false on production
ALLOW_DEV_AUTH=false
# For a live hosted app, set public app URL
VITE_API_URL=
VITE_BOT_USERNAME=
